{
  "name": "@dsh-external/dsh-subagent-antigravity",
  "version": "0.2.0-patched.12",
  "description": "Delegate tasks to Google Antigravity CLI (agy) as a DSH subagent — no Gemini API key needed, uses your Antigravity login",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "PATCH.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojingjing-git/dsh-subagent-agy.git"
  },
  "bugs": {
    "url": "https://github.com/mojingjing-git/dsh-subagent-agy/issues"
  },
  "homepage": "https://github.com/mojingjing-git/dsh-subagent-agy#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "antigravity",
    "agy",
    "gemini",
    "subagent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-jobs": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-jobs": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis-plugin-include": "*",
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-chunked-list": "*",
    "@deepseek-ai/dsh-http-proxy": "*",
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-timeout": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-util-crypto": "*",
    "@deepseek-ai/dsh-util-time": "*",
    "@deepseek-ai/dsh-util-values": "*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "pretest": "node scripts/build.mjs",
    "test": "node test/run.mjs",
    "pretest:panel": "node scripts/build.mjs",
    "test:panel": "node test/panel-sources.mjs && node test/panel-routes.mjs && node test/panel-stream.mjs && node test/panel-client.mjs && node test/agy-models.mjs && node test/agy-summaries.mjs && node test/agy-steps.mjs && node test/agy-history.mjs",
    "test:e2e": "node test/e2e-real.mjs",
    "pack": "node scripts/pack.mjs",
    "selftest": "node scripts/selftest.mjs",
    "selftest:e2e": "node scripts/selftest.mjs --e2e"
  }
}
