{
  "name": "@dsh-external/dsh-subagent-antigravity",
  "version": "0.2.0-patched.5",
  "description": "Delegate tasks to Google Antigravity CLI (agy) as a DSH subagent — no Gemini API key needed, uses your Antigravity login",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "PATCH.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojingjing-git/dsh-subagent-agy.git"
  },
  "bugs": {
    "url": "https://github.com/mojingjing-git/dsh-subagent-agy/issues"
  },
  "homepage": "https://github.com/mojingjing-git/dsh-subagent-agy#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "antigravity",
    "agy",
    "gemini",
    "subagent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-jobs": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/run.mjs",
    "test:e2e": "node test/e2e-real.mjs",
    "pack": "node scripts/pack.mjs",
    "selftest": "node scripts/selftest.mjs",
    "selftest:e2e": "node scripts/selftest.mjs --e2e"
  }
}
